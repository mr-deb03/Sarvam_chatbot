# --- Sarvam AI ---
# Get your key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-subscription-key
# SARVAM_MODEL=sarvam-30b        # or sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

# --- Admin auth (Auth.js) ---
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Email (optional) ---
# SMTP credentials for emailing clients a copy of their request.
# If left unset, submissions still succeed but no email is sent.
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com,
# pass=<a Google App Password> (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# SMTP_FROM=MF Portal <you@example.com>
# ADMIN_EMAIL receives a BCC of every new request (optional).
# ADMIN_EMAIL=admin@example.com
